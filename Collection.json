        {
          "name": "Request 6: POST User trùng email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {\r\n    pm.response.to.have.status(422);\r\n});\r\n\r\npm.test(\"Loi bao email da ton tai\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body[0].field).to.eql(\"email\");\r\n    pm.expect(body[0].message).to.include(\"taken\");\r\n});\r\n\r\n// Don dep user seed\r\npm.sendRequest({\r\n    url: pm.environment.get(\"baseUrl\") + \"/users/\" + pm.environment.get(\"seedId\"),\r\n    method: \"DELETE\",\r\n    header: { \"Authorization\": \"Bearer \" + pm.environment.get(\"token\") }\r\n}, function () {});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tao truoc 1 user voi email {{userEmail}} de dam bao email dang ton tai\r\npm.sendRequest({\r\n    url: pm.environment.get(\"baseUrl\") + \"/users\",\r\n    method: \"POST\",\r\n    header: {\r\n        \"Authorization\": \"Bearer \" + pm.environment.get(\"token\"),\r\n        \"Content-Type\": \"application/json\"\r\n    },\r\n    body: {\r\n        mode: \"raw\",\r\n        raw: JSON.stringify({\r\n            name: \"Seed User\",\r\n            gender: \"male\",\r\n            email: pm.environment.get(\"userEmail\"),\r\n            status: \"active\"\r\n        })\r\n    }\r\n}, function (err, response) {\r\n    if (!err && response.code === 201) {\r\n        pm.environment.set(\"seedId\", response.json().id);\r\n    }\r\n});"
                ]
              }
            }
          ],
