      "item": [
        {
          "name": "Request 1: POST User (DDT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst res = pm.response.json();\r\n\r\npm.test(\"Du lieu tra ve khop voi CSV\", function () {\r\n    pm.expect(res.name).to.eql(pm.iterationData.get(\"name\"));\r\n    pm.expect(res.email).to.eql(pm.iterationData.get(\"email\"));\r\n});\r\n\r\n// Luu ID dong de truyen sang cac request sau\r\npm.environment.set(\"userId\", res.id);\r\npm.environment.set(\"userEmail\", res.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
